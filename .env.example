# Vantage — environment variables. Copy to `.env` and fill in what you need.
#
# NOTHING here is required for the pipeline to run: every credential is optional.
# A source with no key skips itself with a warning and the run still produces
# leads from the others. Keys only raise quotas or unlock a source.
#
# In CI these are GitHub Actions *secrets* (values) and *variables* (non-secret
# config). Never commit a filled-in `.env`.

# =============================================================================
# MedTech signal pipeline — backend/signals/
# =============================================================================

# --- PubMed / NCBI E-utilities ------------------------------------------------
# Optional. Without a key: 3 requests/second. With one: 10/second.
# Free, instant: https://account.ncbi.nlm.nih.gov/settings/ (API Key Management)
NCBI_API_KEY=
# NCBI asks every automated client to identify itself. Strongly recommended —
# it is how they contact you instead of silently blocking your IP.
NCBI_TOOL=vantage-signals
NCBI_EMAIL=
# Override the default MedTech-leaning search (see sources/pubmed.mjs).
PUBMED_QUERY=

# --- Europe PMC ---------------------------------------------------------------
# No key, no registration. Query override only.
EUROPEPMC_QUERY=

# --- EPO OPS (Espacenet patents) ----------------------------------------------
# Required for the patent source. Free but registration-gated; create an app at
# https://developers.epo.org/ and copy its consumer key + secret.
# Without these, `sources/patents.mjs` skips itself and the high-priority rule
# (which needs a patent) can never fire.
EPO_OPS_KEY=
EPO_OPS_SECRET=
# Comma-separated IPC/CPC classes. Default: A61B,A61F,A61M,A61N,G16H,C12Q
EPO_IPC_CLASSES=

# --- ClinicalTrials.gov v2 ----------------------------------------------------
# No key, no registration. Query override only (default targets DEVICE and
# DIAGNOSTIC_TEST interventions).
CLINICALTRIALS_QUERY=

# --- Innovation grants (i-Lab, i-PhD, EIC Accelerator) ------------------------
# None of the three publishes a free, documented, stable JSON API, so the
# connector is a configurable ADAPTER (see sources/grants.mjs). Feeds ship
# pointing at empty placeholder files in sources/data/; override any of them
# with an https URL (a real CSV/JSON export) or a `file:` path to a curated list.
GRANTS_ILAB_URL=
GRANTS_IPHD_URL=
GRANTS_EIC_URL=

# --- INPI / RNE (French legal registry) — the DEFAULT registry source ---------
# Required for the company-incorporation source, which is the third leg of the
# high-priority rule. FREE; create an account at
# https://registre-national-entreprises.inpi.fr and use its e-mail + password.
# The connector logs in via POST /api/sso/login and caches the bearer token.
INPI_USERNAME=
INPI_PASSWORD=
# Comma-separated APE/NAF codes. Default: 2120Z,2660Z,3250A,3250B,7211Z,7219Z
# Do NOT add 6201Z (software) without a keyword filter — it floods the pipeline.
INPI_APE_CODES=

# --- Companies House (UK registry) --------------------------------------------
# FREE, but an API key is required: create a Companies House developer account
# at https://developer.company-information.service.gov.uk and register an
# application. Auth is HTTP Basic with the key as the USERNAME and an empty
# password — a Companies House idiosyncrasy, handled by the connector.
# London-Oxford-Cambridge is the other major European healthtech cluster, so
# this is the highest-value registry after France.
COMPANIES_HOUSE_API_KEY=
# Comma-separated SIC 2007 codes. Default: 21200,26600,32500,72110,72190
COMPANIES_HOUSE_SIC_CODES=

# --- Brønnøysund (Norwegian registry) -----------------------------------------
# NO CREDENTIALS AT ALL — fully open data, so this source always runs.
# Comma-separated NACE codes. Default: 21.20,26.60,32.50,72.11,72.19
BRREG_NACE_CODES=

# --- Pappers (paid alternative to INPI) ---------------------------------------
# Reads the same French registry with a much friendlier API, but it is PAID,
# which collides with the plan's "0 €, aucune source payante" decision. It is
# therefore NOT in the default source list. To use it instead of INPI:
#   SIGNALS_SOURCES=pubmed,europepmc,epo,clinicaltrials,grants,pappers
# Never enable both: each would emit a company_creation record per SIREN.
PAPPERS_API_KEY=
PAPPERS_NAF_CODES=

# --- Pipeline behaviour -------------------------------------------------------
# Which connectors to run (comma-separated). Default: all six.
SIGNALS_SOURCES=
# Lookback for publications, patents and trials. Default 30.
SIGNALS_LOOKBACK_DAYS=
# Lookback for grants and incorporations. Default 183 — it MUST cover the
# "société créée < 6 mois" window the high-priority rule asks about.
SIGNALS_SLOW_LOOKBACK_DAYS=
# Max pages per source, so a broad query cannot run away. Default 5.
SIGNALS_MAX_PAGES=
# Response cache TTL in minutes (0 disables). Default 720 (12 h).
SIGNALS_CACHE_TTL_MIN=
# Where the disposable HTTP cache lives. Default <repo>/.cache/signals
SIGNALS_CACHE_DIR=
# Where the committed diffing state lives. Default <repo>/signal-state
SIGNALS_STATE_DIR=
# Where the published leads file is written. Default <repo>/medtech-leads.json
SIGNALS_LEADS_PATH=
# Port for the local leads endpoint (`npm run serve`). Default 8787.
SIGNALS_PORT=

# =============================================================================
# Favorites news routine — backend/routine/
# =============================================================================

# Research (Anthropic SDK).
ANTHROPIC_API_KEY=
# Service-account JSON (as a single-line string) for the Firestore union read.
FIREBASE_SERVICE_ACCOUNT=
# "owner/repo" the routine pushes the refreshed news file to.
CONTENT_REPO=pierreespy/vantage-content
# PAT with push access to CONTENT_REPO.
CONTENT_REPO_TOKEN=
# Path of the news file in that repo. Default startup-news.json
CONTENT_NEWS_PATH=
# Branch to push. Default main
CONTENT_BRANCH=

# =============================================================================
# Shared
# =============================================================================

# "1" runs everything but the writes / git push. Used for local testing by both
# the favorites routine and the signal pipeline.
DRY_RUN=
